{
  "project": "GenericAgent Web UI",
  "version": "0.1.0",
  "created_at": "2026-06-15",
  "description": "GenericAgent 多 Agent 管理面板 - 适配前端 Web UI",
  "backend": {
    "type": "FastAPI",
    "entry": "web_ui/app.py",
    "port": 8765,
    "entry_script": "web_ui/start.py"
  },
  "frontend": {
    "type": "原生 JavaScript (Vanilla JS)",
    "dir": "proto_ui",
    "build_script": "web_ui/start.py (内置静态服务)"
  },
  "modules": {
    "core_engine": {
      "path": "agent_loop.py",
      "description": "Agent 核心循环 + BaseHandler/agent_runner_loop"
    },
    "handler": {
      "path": "ga.py",
      "description": "GenericAgentHandler - code_run/文件/记忆等工具实现"
    },
    "llm_client": {
      "path": "agentmain.py",
      "description": "GeneraticAgent - 多 LLM session 管理，队列和多实例"
    },
    "llm_core": {
      "path": "llmcore.py",
      "description": "LLM client - 各种 LLM 封装 (Claude/OA/原生等"
    },
    "memory_system": {
      "path": "memory/",
      "description": "L0-L4 分层记忆 (元规则/索引/全局/技能/归档"
    },
    "skills": {
      "path": "memory/ 下的各个 .py 和 .md",
      "description": "Skill 目录"
    },
    "bots": {
      "path": "frontends/",
      "description": "fsapp/wechatapp/qqapp/tgapp/dingtalk/stapp/qtapp 等"
    },
    "desktop_pet": {
      "path": "frontends/desktop_pet.pyw",
      "description": "桌面宠物"
    }
  },
  "dependencies": {
    "python": [
      "fastapi",
      "uvicorn[standard]",
      "websockets"
    ],
    "existing": [
      "lark-oapi (飞书)",
      "PIL/Pillow (图像处理)",
      "requests (HTTP)",
      "标准库 (subprocess/threading/queue/json/re/os/sys/tempfile",
      "标准库 datetime/pathlib/importlib/traceback",
      "importlib 动态导入"
    ]
  },
  "data_formats": {
    "session": {
      "id": "string",
      "title": "string",
      "created_at": "ISO8601",
      "updated_at": "ISO8601",
      "turns": "number",
      "token_count": "number",
      "status": "running|done|stopped|error"
    },
    "message": {
      "id": "string",
      "role": "user|assistant|system|tool",
      "content": "string",
      "ts": "ISO8601"
    },
    "tool_call": {
      "id": "string",
      "name": "string",
      "args": "object",
      "status": "running|done|error",
      "result": "any"
    }
  },
  "api_routes": {
    "GET": [
      "/api/status",
      "/api/sessions",
      "/api/sessions/{id}",
      "/api/llm/models",
      "/api/settings",
      "/api/skills",
      "/api/memory/layers",
      "/api/memory/layer/{level}",
      "/api/files/browse?path=",
      "/api/conductor/status",
      "/api/hive/status",
      "/api/morphling/capabilities"
    ],
    "POST": [
      "/api/chat/send",
      "/api/chat/stop",
      "/api/sessions/new",
      "/api/sessions/{id}/restore",
      "/api/llm/switch?index=",
      "/api/files/read",
      "/api/files/write",
      "/api/files/upload",
      "/api/settings/update",
      "/api/conductor/start",
      "/api/hive/start",
      "/api/hive/post",
      "/api/morphling/import"
    ],
    "WS": [
      "/ws/chat/{session_id}"
    ]
  },
