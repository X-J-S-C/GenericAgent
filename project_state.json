  "task_09_unified_json_format": {
    "status": "completed",
    "file": "api_server.py",
    "schema": {
      "ApiMessage": {
        "id": "string (auto-generated, e.g. msg_abc123)",
        "type": "message | control | status | error",
        "subtype": "next | done | start | ping | pong | abort | abort_ack | agent_status | llm_list | llm_switched | error",
        "task_id": "string | null",
        "role": "user | assistant | system | tool | null",
        "content": "string | null",
        "metadata": {
          "timestamp": "ISO8601 UTC",
          "source": "string | null",
          "images": "string[] | null",
          "llm_no": "int | null",
          "llm_name": "string | null",
          "is_running": "bool | null",
          "error_code": "string | null"
        }
      }
    },
    "websocket_protocol": {
      "client_send": [
        {"type": "control", "subtype": "subscribe", "description": "Subscribe/drain queue for task"},
        {"type": "control", "subtype": "abort",     "description": "Abort running task"},
        {"type": "control", "subtype": "ping",      "description": "Keep-alive ping"}
      ],
      "server_send": [
        {"type": "message",  "subtype": "next",        "fields": ["task_id", "content", "role", "metadata"]},
        {"type": "message",  "subtype": "done",        "fields": ["task_id", "content", "role", "metadata"]},
        {"type": "message",  "subtype": "start",       "fields": ["task_id", "content", "role", "metadata"]},
        {"type": "control",  "subtype": "abort_ack",   "fields": ["task_id"]},
        {"type": "control",  "subtype": "pong",        "fields": []},
        {"type": "status",   "subtype": "agent_status", "fields": ["metadata.is_running", "metadata.llm_no", "metadata.llm_name"]},
        {"type": "status",   "subtype": "llm_list",     "fields": ["content (JSON array)"]},
        {"type": "status",   "subtype": "llm_switched", "fields": ["metadata.llm_no", "metadata.llm_name"]},
        {"type": "error",    "subtype": "error",        "fields": ["task_id", "content", "metadata.error_code"]}
      ]
    },
    "design_notes": [
      "Single ApiMessage envelope for ALL WS and HTTP communications",
      "Enums: MsgType, MsgSubtype, Role for type safety",
      "Convenience constructors: msg_next(), msg_done(), msg_pong(), msg_abort_ack(), msg_error(), msg_agent_status(), msg_llm_list(), msg_llm_switched()",
      "to_ws_dict() serializes for transport; from_dict() parses incoming",
      "Metadata.timestamp auto-generated as ISO8601 UTC"
    ]
  },
