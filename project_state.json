  "api_routes": {
    "GET /": "服务健康检查",
    "GET /api/status": "Agent 状态（is_running, llm_no, llm_name, current_task_id）",
    "GET /api/llms": "列出所有可用 LLM",
    "POST /api/llm/switch": "切换 LLM（body: {index: int}）",
    "POST /api/abort": "中止当前任务",
    "POST /api/chat": "发送消息，返回 task_id（body: {message: str, source?: str}）",
    "WS /ws/{task_id}": "WebSocket 流式接收任务响应"
  },
  "websocket_protocol": {
    "client_send": {
      "subscribe": "开始订阅（首个消息）",
      "abort": "中止任务",
      "ping": "心跳"
    },
    "server_send": {
      "subscribed": "订阅确认",
      "next": "增量文本输出 {content, source}",
      "tool_start": "工具调用开始 {tool_call: {id, name, args}}",
      "tool_end": "工具调用结束 {tool_call: {...}, success}",
      "done": "最终响应 {content, source, tool_calls?}",
      "error": "错误 {message, code?}",
      "pong": "心跳响应"
    }
  },
  "dependencies": {
    "fastapi": ">=0.115",
    "uvicorn": ">=0.30"
  },
  "start_commands": {
    "api_only": "uvicorn api_server:app --host 0.0.0.0 --port 18792 --reload",
    "unified": "python start.py",
    "unified_with_bots": "python start.py --tg --feishu --pet"
  },
