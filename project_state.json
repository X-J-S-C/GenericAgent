  "task_02_backend_fastapi": {
    "status": "completed",
    "file": "api_server.py",
    "start_command": "uvicorn api_server:app --host 0.0.0.0 --port 18792 --reload",
    "api_routes": [
      {"method": "GET",  "path": "/",                       "description": "Health check → ApiMessage"},
      {"method": "GET",  "path": "/api/status",            "description": "Agent status → ApiMessage(agent_status)"},
      {"method": "GET",  "path": "/api/llms",              "description": "List LLMs → ApiMessage(llm_list)"},
      {"method": "POST", "path": "/api/llm/switch",        "description": "Switch LLM → ApiMessage(llm_switched)"},
      {"method": "POST", "path": "/api/abort",             "description": "Abort → ApiMessage(abort_ack)"},
      {"method": "POST", "path": "/api/chat",              "description": "Send message → ApiMessage(start) with task_id"},
      {"method": "WS",   "path": "/ws/{task_id}",         "description": "Stream responses via ApiMessage"}
    ]
  },
  "task_09_unified_json_format": {
    "status": "completed",
    "file": "api_server.py",
    "schema": {
      "ApiMessage": {
        "id": "string (auto-generated, e.g. msg_abc123)",
        "type": "message | control | status | error",
        "subtype": "next | done | start | ping | pong | abort | abort_ack | agent_status | llm_list | llm_switched | error",
        "task_id": "string | null",
        "role": "user | assistant | system | tool | null",
        "content": "string | null",
        "metadata": {
          "timestamp": "ISO8601 UTC",
          "source": "string | null",
          "images": "string[] | null",
          "llm_no": "int | null",
          "llm_name": "string | null",
          "is_running": "bool | null",
          "error_code": "string | null"
        }
      }
    }
  },
