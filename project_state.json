{
  "project": "GenericAgent",
  "version": "0.1.0",
  "last_updated": "2026-06-15",
  "task_02_backend_fastapi": {
    "status": "completed",
    "file": "api_server.py",
    "start_command": "uvicorn api_server:app --host 0.0.0.0 --port 18792 --reload",
    "api_routes": [
      {"method": "GET",  "path": "/",                       "description": "Health check"},
      {"method": "GET",  "path": "/api/status",            "description": "Agent status (is_running, llm_no, llm_name)"},
      {"method": "GET",  "path": "/api/llms",               "description": "List all available LLMs"},
      {"method": "POST", "path": "/api/llm/switch",         "description": "Switch LLM by index (body: {index})"},
      {"method": "POST", "path": "/api/abort",              "description": "Abort current running task"},
      {"method": "POST", "path": "/api/chat",               "description": "Send message, returns {task_id}"},
      {"method": "WS",   "path": "/ws/{task_id}",          "description": "WebSocket streaming for task responses"}
    ],
    "websocket_protocol": {
      "client_send": [
        {"type": "subscribe", "description": "Start receiving queued messages"},
        {"type": "abort",     "description": "Abort the running task"},
        {"type": "ping",      "description": "Keep-alive ping"}
      ],
      "server_send": [
        {"type": "next",   "fields": ["content", "source"], "description": "Streaming chunk"},
        {"type": "done",   "fields": ["content", "source"], "description": "Task complete"},
        {"type": "error",  "fields": ["message"],           "description": "Error occurred"},
        {"type": "abort_ack", "description": "Abort acknowledged"},
        {"type": "pong",   "description": "pong response to ping"}
      ]
    },
    "design_notes": [
      "GeneriAgent runs in a daemon thread started via lifespan context manager",
      "HTTP POST /api/chat returns task_id; frontend WS connects to /ws/{task_id}",
      "asyncio.Queue bridges Python threading.Queue → WebSocket",
      "In-memory task registry maps task_id → asyncio.Queue"
    ]
  },
