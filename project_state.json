      "stapp_refactor": "Replaced direct GeneriAgent usage with AgentAPIClient; agent_backend_stream() now uses client.send_message() internally",
      "shared_enums": "MsgType, MsgSubtype, Role, ApiMessage mirrored in api_client.py for frontend use"
    },
