  "api_routes": {
    "GET /": "服务健康检查",
    "GET /api/status": "获取 Agent 运行状态（is_running, llm_no, llm_name）",
    "GET /api/llms": "列出所有可用 LLM",
    "POST /api/llm/switch": "切换 LLM（body: {index: int}）",
    "POST /api/abort": "中止当前任务",
    "POST /api/chat": "发送消息，返回 task_id（body: {message: str, source?: str}）",
    "WS /ws/{task_id}": "WebSocket 流式接收任务响应"
  },
  "websocket_protocol": {
    "client_send": {"subscribe": "开始订阅", "abort": "中止任务", "ping": "心跳"},
    "server_send": {"next": "增量输出", "done": "最终响应", "error": "错误", "subscribed": "订阅确认"}
  },
  "dependencies": {
    "fastapi": ">=0.115",
    "uvicorn": ">=0.30"
  },
  "start_command": "uvicorn api_server:app --host 0.0.0.0 --port 18792 --reload",
  "files": {
    "api_server.py": "FastAPI 后端主文件（任务 02 完成）"
